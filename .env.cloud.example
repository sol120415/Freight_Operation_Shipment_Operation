# =====================================================================
# CLOUD database (production / diretso, walang Docker kailangan)
# Kopyahin ito bilang basehan:  npm run env:cloud   (o manual copy)
# Tapos punan ang 3 keys mula sa Supabase Dashboard → Project Settings → API
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-cloud-anon-key

# Server-only. Huwag i-expose sa browser.
SUPABASE_SERVICE_ROLE_KEY=your-cloud-service-role-key

# Kailangan internet dito. Walang Docker na bubuksan.
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=5

# ---- AI Providers (server-only, kailangan internet) ----
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# ---- Production email for OTP (server-only, SMTP/Nodemailer) ----
# Required for Login, Seller Registration, and Forgot Password OTP.
# Without these, OTP sending fails closed (no code is verified, no account
# is created, and no password is changed). Use SMTP credentials from your provider.
# Port 587 normally uses STARTTLS (SMTP_SECURE=false); port 465 uses TLS (true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=
OTP_FROM_NAME=Airship Express
