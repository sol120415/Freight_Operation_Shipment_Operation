# =====================================================================
# ENVIRONMENT SWITCH: Local (dev/test) vs Cloud (production)
# Copy this file to .env.local and fill ONE block.
# Tip: use `npm run env:local` / `npm run env:cloud` to switch (see below).
# =====================================================================

# ---- Option A: LOCAL database (development / testing) ----
# Run: npx supabase start  →  URLs + keys from `npx supabase status`
# Studio: http://127.0.0.1:54323 | Mail (OTP): http://127.0.0.1:54324
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ---- Option B: CLOUD database (production) ----
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by trusted API routes / seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inactivity session timeout (minutes). Mirrors [auth.sessions]
# inactivity_timeout in supabase/config.toml. Default 5.
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=5

# ---- AI Providers (server-only) ----
# Automated routing recommendations & Bill of Lading parsing.
# Provide at least one. The app prefers GROQ, then GEMINI.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# ---- Email OTP via SMTP (server-only) ----
# Leave empty in local dev: OTP codes print to the server terminal instead.
# Port 587 normally uses STARTTLS (SMTP_SECURE=false); port 465 uses TLS (true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=
OTP_FROM_NAME=Airship Express
