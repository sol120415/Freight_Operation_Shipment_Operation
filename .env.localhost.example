# =====================================================================
# LOCAL database (offline-capable, kailangan ng Docker Desktop)
# Kopyahin ito bilang basehan:  npm run env:local   (o manual copy)
# URLs + keys ay galing sa:  npx supabase status   (pagkatapos ng supabase start)
# Studio: http://127.0.0.1:54323 | OTP mailbox: http://127.0.0.1:54324
# Gumagana kahit walang internet (maliban sa AI features).
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only. Huwag i-expose sa browser.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=5

# ---- AI Providers (server-only, kailangan internet kahit naka-Local ka) ----
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# ---- Email OTP via SMTP (server-only) ----
# Opsyonal sa Local: kapag walang laman, OTP codes ay lalabas sa terminal.
# Port 587 karaniwan ay STARTTLS (false); port 465 ay TLS (true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=
OTP_FROM_NAME=Airship Express
