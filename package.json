{
  "name": "freight-ops",
  "version": "3.1.0",
  "private": true,
  "description": "Freight Operations & Shipment Execution Subsystem",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:local": "node scripts/switch-env.js local && next dev -p 3001",
    "dev:cloud": "node scripts/switch-env.js cloud && next dev -p 3001",
    "env:local": "node scripts/switch-env.js local",
    "env:cloud": "node scripts/switch-env.js cloud",
    "env:cloud:init": "node scripts/switch-env.js cloud:init",
    "env:status": "node scripts/switch-env.js status",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:production": "node scripts/production-smoke.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "gen:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.0",
    "@types/qrcode": "^1.5.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.451.0",
    "nanoid": "^3.3.18",
    "next": "^15.5.27",
    "nodemailer": "^10.1.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.30",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
