{
  "name": "freight-ops",
  "version": "3.1.0",
  "private": true,
  "description": "Freight Operations & Shipment Execution Subsystem",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:local": "node scripts/switch-env.js local && next dev -p 3001",
    "dev:cloud": "node scripts/switch-env.js cloud && next dev -p 3001",
    "env:local": "node scripts/switch-env.js local",
    "env:cloud": "node scripts/switch-env.js cloud",
    "env:cloud:init": "node scripts/switch-env.js cloud:init",
    "env:status": "node scripts/switch-env.js status",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "gen:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.451.0",
    "next": "15.5.23",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
